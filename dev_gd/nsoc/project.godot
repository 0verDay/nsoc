; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="NSOC"
run/main_scene="res://scenes/VideoSplash.tscn"
config/quit_on_go_back=false
config/features=PackedStringArray("4.6", "Forward Plus")
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/show_image=true
boot_splash/image="res://assets/splash_black.png"
boot_splash/fullsize=true
config/icon="res://icon.svg"

[autoload]

Effects="*res://scripts/core/effect_registry.gd"
HeroAbilities="*res://scripts/core/hero_ability_registry.gd"
Equipments="*res://scripts/core/equipment_manager.gd"
Objectives="*res://scripts/core/objective_registry.gd"
Game="*res://scripts/core/game_context.gd"
QuitConfirm="*res://scripts/core/quit_confirm.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=960
window/size/window_height_override=540
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation="landscape"

[input_devices]

pointing/emulate_touch_from_mouse=true

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(1, 1, 1, 1)
